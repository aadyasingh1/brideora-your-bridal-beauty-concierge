# Environment Configuration Template
# Copy this to .env.local and fill in your actual values

# ============================================
# SUPABASE (Database)
# ============================================
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ============================================
# RAZORPAY (Payments)
# ============================================
# Get from: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=your_secret_key_here

# Webhook secret from: Razorpay → Settings → Webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# GOOGLE GEMINI AI (Recommendations)
# ============================================
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# EMAIL (Gmail/SMTP)
# ============================================
# SMTP Settings for Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Generate app-specific password: https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_char_app_password

# Sender details
SMTP_FROM_EMAIL=noreply@brideora.com
SMTP_FROM_NAME=Brideora

# ============================================
# WHATSAPP BUSINESS API
# ============================================
# Get from: WhatsApp Business Account → Settings
WHATSAPP_API_URL=https://graph.instagram.com/v18.0
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ============================================
# SMS (Optional - Twilio)
# ============================================
# Get from: Twilio Console
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ============================================
# N8N
# ============================================
N8N_WEBHOOK_BASE_URL=https://aaadyasingh1.app.n8n.cloud/webhook
N8N_WORKFLOW_ID=QKrKA8oXiY06dYBT

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
VITE_API_BASE_URL=http://localhost:8080/api

# ============================================
# ADMIN EMAIL (for notifications)
# ============================================
ADMIN_EMAIL=admin@brideora.com
FOUNDER_EMAIL=founder@brideora.com
